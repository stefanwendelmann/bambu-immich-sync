BAMBU_HOST=REPLACE_WITH_PRINTER_IP_OR_HOSTNAME
BAMBU_ACCESS_CODE=REPLACE_WITH_PRINTER_LAN_ACCESS_CODE
BAMBU_FTPS_PORT=990
BAMBU_REMOTE_PATH=/timelapse
# The Bambu's certificate may be self-signed; false is intended ONLY for a trusted local network.
# The P2S currently requires TLS 1.2 and SNI for compatible implicit FTPS data connections.
BAMBU_TLS_VERIFY=false
IMMICH_INSTANCE_URL=https://immich.example.org/api
IMMICH_API_KEY=REPLACE_WITH_IMMICH_API_KEY
IMMICH_ALBUM_NAME=Bambu Timelapses
SYNC_INTERVAL=300
DELETE_LOCAL_AFTER_UPLOAD=false
RUN_ONCE=false
DATA_DIR=/data
